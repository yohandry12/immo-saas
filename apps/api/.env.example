# Copier vers .env et remplir. Ne JAMAIS committer .env.
DATABASE_URL=postgresql://immo:immo_dev@localhost:5432/immo
JWT_SECRET=changer-moi-64-caracteres-aleatoires
PORT=4000
REDIS_URL=redis://:immo_redis_dev@localhost:6379
# development | test | production. En production, MOMO_PROVIDER=mock est
# refusé au démarrage (webhooks non vérifiés = loyers forgeables).
NODE_ENV=development
# Nombre de proxys de confiance DEVANT l'API (reverse proxy, load balancer).
# 0 = API exposée en direct. Derrière Nginx seul : 1. Derrière Cloudflare
# + Nginx : 2. Mal réglé, le rate-limit compte tous les clients ensemble.
TRUST_PROXY=0
# Origine autorisée par CORS (le front)
WEB_ORIGIN=http://localhost:3000
# "mock" (tests, développement uniquement) ou "notchpay" (sandbox/prod)
MOMO_PROVIDER=mock
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_WEBHOOK_URL=
